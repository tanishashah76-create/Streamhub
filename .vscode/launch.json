{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Django Run Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "127.0.0.1:8000"
            ],
            "django": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Django (No Reload)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "--noreload",
                "127.0.0.1:8000"
            ],
            "django": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}
